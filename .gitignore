# Ignore downloaded raw datasets
data/raw_data/
data/tb/raw_data/
data/skin/raw_data/
data/ophthalmic/raw_data/

# Ignore Python cache and environment files
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints

# Ignore Kaggle API credentials (CRITICAL FOR SECURITY)
kaggle.json

# Ignore compiled TFLite models during active training (optional, but good practice)
*.tflite
